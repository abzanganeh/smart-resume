# Production TLS reverse proxy for Flint Apply (Caddy 2)
# Copy to /etc/caddy/Caddyfile on the deployment VM.
#
# Prerequisites:
#   - docker compose staging stack on localhost:3000 (frontend) and :8000 (backend)
#     Set STAGING_FRONTEND_PORT=3000 and STAGING_BACKEND_PORT=8000 in .env.staging
#   - DNS A/AAAA records:
#       flintapply.com  → VM
#       api.flintapply.com → VM (or use flintapply.com/api via path routing — not shown here)
#
# Backend (backend/.env.staging):
#   FRONTEND_BASE_URL=https://flintapply.com
#   ALLOWED_ORIGINS=["https://flintapply.com"]
#
# Frontend (.env.staging):
#   NEXTAUTH_URL=https://flintapply.com
#   NEXT_PUBLIC_SITE_URL=https://flintapply.com
#   NEXT_PUBLIC_API_URL=https://api.flintapply.com
#
# OAuth redirect URIs (Google, GitHub, LinkedIn, etc.):
#   https://flintapply.com/api/auth/callback/<provider>
#
# Stripe webhook:
#   https://api.flintapply.com/api/billing/webhook

# Shared edge headers (OWASP A02 / M23 A2). Frontend CSP-Report-Only is emitted
# by Next.js upstream; Caddy adds transport and baseline headers for both vhosts.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(self), usb=()"
		-Server
	}
}

flintapply.com {
	import security_headers
	encode gzip
	reverse_proxy localhost:3000
}

api.flintapply.com {
	import security_headers
	# JSON API: deny embedding and shrink default fetch surface at the edge.
	header Content-Security-Policy-Report-Only "default-src 'none'; frame-ancestors 'none'"
	encode gzip
	reverse_proxy localhost:8000
}
