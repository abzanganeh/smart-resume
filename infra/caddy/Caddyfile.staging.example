# Example TLS reverse proxy for staging VM (Caddy 2)
# Production (flintapply.com): see Caddyfile.production.example in this directory.
# Copy to /etc/caddy/Caddyfile and set domain names + upstream ports.
#
# Prerequisites:
#   - docker compose staging stack on localhost:3001 (frontend) and :8001 (backend)
#   - DNS A records for staging.example.com and staging-api.example.com
#
# Then set in backend/.env.staging:
#   FRONTEND_BASE_URL=https://staging.example.com
#   ALLOWED_ORIGINS=["https://staging.example.com"]
# And in .env.staging:
#   NEXTAUTH_URL=https://staging.example.com
#   STAGING_FRONTEND_PORT=3001
#   STAGING_BACKEND_PORT=8001

# Shared edge headers (OWASP A02 / M23 A2). Frontend CSP-Report-Only is emitted
# by Next.js upstream; Caddy adds transport and baseline headers for both vhosts.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(self), usb=()"
		-Server
	}
}

staging.example.com {
	import security_headers
	encode gzip
	reverse_proxy localhost:3001
}

staging-api.example.com {
	import security_headers
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	encode gzip
	reverse_proxy localhost:8001
}
