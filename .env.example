# Docker Compose — host port overrides (copy to .env if defaults conflict)
# Defaults avoid common local Postgres (5432) and Redis (6379) installs.

POSTGRES_HOST_PORT=54325
REDIS_HOST_PORT=6380
POSTGRES_PASSWORD=password

# Frontend auth (Docker / local)
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=local-docker-dev-secret-change-me

# Optional — Google/GitHub SSO (leave blank to use email/password only locally)
# For Docker: set these here AND in backend/.env (compose build args read from this file).
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
