# Docker Compose — host port overrides (copy to .env if defaults conflict)
# Defaults avoid common local Postgres (5432) and Redis (6379) installs.

POSTGRES_HOST_PORT=54325
REDIS_HOST_PORT=6380
POSTGRES_PASSWORD=password

# Frontend auth (Docker / local)
# Staging/production: set NEXTAUTH_URL to the public frontend origin.
# Local npm run dev: leave NEXTAUTH_URL unset (or commented) when testing from a
# LAN IP — auth.ts trusts Host so OAuth cookies match the browser URL. Add each
# dev origin to Google "Authorized redirect URIs", e.g.:
#   http://localhost:3000/api/auth/callback/google
#   http://192.168.x.x:3000/api/auth/callback/google
# NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=local-docker-dev-secret-change-me

# Optional — Google/GitHub/Microsoft/LinkedIn/Apple SSO (leave blank for email/password only locally)
# For Docker: set these here AND in backend/.env (compose build args read from this file).
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs (same OAuth client):
#   http://localhost:3000/api/auth/callback/google          — web app (NextAuth)
#   http://localhost:3000/auth/extension/google/callback    — browser extension
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
