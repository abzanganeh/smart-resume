# Flint Apply — Frontend environment (copy to .env.local)

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
# When opening the app from another device on your LAN (e.g. http://192.168.x.x:3000),
# either use localhost only or set NEXTAUTH_URL to that host. Server session in layout
# avoids a hung sign-in page, but OAuth redirect URIs must match this value.
NEXTAUTH_SECRET=change-me-in-production

# OAuth SSO (optional — buttons hidden until both id + secret are set)
# When using `npm run dev`, put credentials here. Docker Compose reads repo root `.env`.
# Redirect URIs to register with each provider:
#   Google / GitHub / Microsoft / LinkedIn: http://localhost:3000/api/auth/callback/<provider-id>
#   provider-id values: google, github, microsoft-entra-id, linkedin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Web push (VAPID public key only — must match backend WEB_PUSH_VAPID_PUBLIC_KEY)
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Optional: injected into service worker at build (scripts/inject-sw-version.mjs)
NEXT_PUBLIC_GIT_SHA=dev

# Apple Pay domain verification (Stripe Dashboard → Apple Pay → Add domain).
# Paste the one-line file contents from Stripe, or place the downloaded file at
# public/.well-known/apple-developer-merchantid-domain-association
# APPLE_PAY_DOMAIN_ASSOCIATION=
