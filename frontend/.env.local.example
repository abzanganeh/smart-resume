# Smart Resume — Frontend environment (copy to .env.local)

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production

# Web push (VAPID public key only — must match backend WEB_PUSH_VAPID_PUBLIC_KEY)
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Optional: injected into service worker at build (scripts/inject-sw-version.mjs)
NEXT_PUBLIC_GIT_SHA=dev
