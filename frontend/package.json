{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/inject-sw-version.mjs",
    "predev": "node scripts/inject-sw-version.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node --require tsx/cjs --test tests/*/*.test.ts tests/*/*.test.tsx",
    "test:ci": "npm run lint && npm run test:unit && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "rm -rf .next/cache/fetch-cache .next/dev/cache/fetch-cache && playwright test tests/e2e/legal.spec.ts tests/e2e/landing.spec.ts tests/e2e/landing-interactive.spec.ts tests/e2e/auth.spec.ts tests/e2e/jobs.spec.ts tests/e2e/tracker.spec.ts tests/e2e/onboarding.spec.ts",
    "test:e2e:pricing-unsynced": "rm -rf .next/cache/fetch-cache .next/dev/cache/fetch-cache && MOCK_PRICES_UNSYNCED=1 playwright test tests/e2e/landing-pricing-unsynced.spec.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@types/zxcvbn": "^4.4.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^7"
  },
  "pnpm": {
    "overrides": {
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "js-yaml": ">=4.3.1",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@5": "5.0.9"
    }
  }
}
