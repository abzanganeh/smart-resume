# Staging frontend / compose OAuth — copy to .env.staging (gitignored via *.env)
# Ports for local staging simulation (avoid npm dev on :3000)
STAGING_FRONTEND_PORT=3001
STAGING_BACKEND_PORT=8001
POSTGRES_PASSWORD=password

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
