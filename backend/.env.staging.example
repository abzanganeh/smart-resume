# Flint Apply staging backend — copy to backend/.env.staging (gitignored via *.env)
# Generate secrets: python3 scripts/setup-staging-env.py

APP_ENV=staging
USE_IN_MEMORY_STORE=false

DATABASE_URL=postgresql+asyncpg://smart_resume:password@postgres:5432/smart_resume
REDIS_URL=redis://redis:6379

# Required in staging (generate with setup-staging-env.py)
AUTH_SECRET=
BYOK_ENCRYPTION_KEY=
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

FRONTEND_BASE_URL=http://localhost:3001
# Production: https://flintapply.com
ALLOWED_ORIGINS=["http://localhost:3001"]

# Platform LLM (at least one required for tailoring smoke)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GOOGLE_API_KEY=

# Embeddings (falls back to OPENAI_API_KEY if unset)
OPENAI_EMBEDDING_KEY=

# Stripe test mode — required for billing smoke; use price_* IDs from Stripe dashboard
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_WEEKLY=price_...
STRIPE_PRICE_MONTHLY_PRO=price_...
STRIPE_PRICE_YEARLY_PRO=price_...
STRIPE_PRICE_MONTHLY_PLUS=price_...
STRIPE_PRICE_YEARLY_PLUS=price_...
STRIPE_PRICE_MONTHLY_PREMIUM=price_...
STRIPE_PRICE_YEARLY_PREMIUM=price_...
STRIPE_PRICE_BETTER_PACK=price_...
STRIPE_PRICE_BETTER_MONTHLY=price_...
STRIPE_PRICE_BETTER_YEARLY=price_...
STRIPE_PRICE_BEST_PER_RESUME=price_...
STRIPE_PRICE_BEST_MONTHLY=price_...
STRIPE_PRICE_BEST_YEARLY=price_...

# Email (Resend) — required for verification flows
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# Internal scheduler (closure tick + future cron hooks)
INTERNAL_SCHEDULER_SECRET=

# OAuth (optional per provider; mirror values in root .env.staging)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
