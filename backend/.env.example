# Smart Resume Agent — Backend Environment Variables
#
# Setup:
#   cp .env.example .env
#   Edit .env with your real API key (do NOT commit .env to git)
#   Restart the backend after any change to this file
#
# The UI also shows these options under "Advanced: LLM Provider" on the JD step.

# =============================================================================
# LLM PROVIDER & MODEL REFERENCE
# =============================================================================
#
# Set LLM_PROVIDER to one row below, then set LLM_MODEL to a model from that row.
# Only the API key for your chosen provider is required.
#
# ┌─────────────┬──────────────────────────────┬─────────────────────────────────────────────────────────────┐
# │ LLM_PROVIDER│ Env var for API key          │ LLM_MODEL options (pick one)                                │
# ├─────────────┼──────────────────────────────┼─────────────────────────────────────────────────────────────┤
# │ openai      │ OPENAI_API_KEY               │ gpt-4o              ← recommended (best balance)            │
# │             │ platform.openai.com/api-keys │ gpt-4o-mini         ← fast & cheap, good for testing      │
# │             │                              │ gpt-4-turbo         ← previous flagship, higher cost      │
# ├─────────────┼──────────────────────────────┼─────────────────────────────────────────────────────────────┤
# │ anthropic   │ ANTHROPIC_API_KEY            │ claude-3-5-sonnet-20241022  ← recommended                 │
# │             │ console.anthropic.com        │ claude-3-opus-20240229      ← highest quality             │
# │             │                              │ claude-3-haiku-20240307     ← fast & cheap                │
# ├─────────────┼──────────────────────────────┼─────────────────────────────────────────────────────────────┤
# │ gemini      │ GOOGLE_API_KEY               │ gemini-2.5-flash        ← recommended (fast & cheap)       │
# │             │ aistudio.google.com/apikey   │ gemini-3.5-flash        ← latest stable flash             │
# │             │                              │ gemini-2.5-flash-lite   ← cheapest                        │
# ├─────────────┼──────────────────────────────┼─────────────────────────────────────────────────────────────┤
# │ openrouter  │ OPENROUTER_API_KEY           │ meta-llama/llama-3.1-70b-instruct                           │
# │             │ openrouter.ai/keys           │ meta-llama/llama-3.1-8b-instruct                            │
# │             │ (300+ models, one key)       │ mistralai/mixtral-8x7b-instruct                             │
# │             │                              │ anthropic/claude-3.5-sonnet                                 │
# │             │                              │ openai/gpt-4o                                               │
# ├─────────────┼──────────────────────────────┼─────────────────────────────────────────────────────────────┤
# │ ollama      │ (none — runs locally)        │ llama3.1:8b         ← recommended (fast, free)            │
# │             │ ollama.com                   │ llama3.1:70b        ← higher quality, needs more RAM       │
# │             │ ollama pull llama3.1:8b      │ mistral:7b          ← lightweight                          │
# │             │                              │ qwen2.5:14b         ← strong coding/reasoning              │
# └─────────────┴──────────────────────────────┴─────────────────────────────────────────────────────────────┘
#
# Notes:
# - Placeholder keys (sk-..., sk-ant-..., sk-or-...) are ignored by the app.
# - Ollama always appears in the UI even without a cloud API key.
# - OpenRouter accepts any model id from https://openrouter.ai/models (not just the list above).

# =============================================================================
# ACTIVE CONFIG — edit these
# =============================================================================

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# --- API keys (only fill in the one matching LLM_PROVIDER above) ---

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=
OPENROUTER_API_KEY=sk-or-...

# Platform-owned OpenAI key used exclusively for master-resume embeddings
# (text-embedding-3-small).  See IMPLEMENTATION_PLAN §6a — embeddings must use a
# canonical model so JD vectors and chunk vectors live in the same space.  If
# left blank the backend falls back to OPENAI_API_KEY in local/development.
OPENAI_EMBEDDING_KEY=

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# INFRASTRUCTURE
# =============================================================================

REDIS_URL=redis://localhost:6379
# true = no Redis needed for local dev
USE_IN_MEMORY_STORE=true

# Frontend URL for CORS (must match where Next.js runs)
ALLOWED_ORIGINS=["http://localhost:3000"]

# Optional error tracking
SENTRY_DSN=

# =============================================================================
# DATABASE (PostgreSQL + pgvector)
# =============================================================================
# For local dev start postgres with: docker compose up -d postgres
# Then run migrations: cd backend && uv run alembic upgrade head

DATABASE_URL=postgresql+asyncpg://smart_resume:password@localhost:5432/smart_resume

# =============================================================================
# APP ENVIRONMENT
# =============================================================================
# Allowed values: local | development | ci | staging | production
# Controls security decisions (auth enforcement, debug helpers, etc.).
# Never compare APP_ENV directly outside of config.py — use is_production_grade().

APP_ENV=local

# =============================================================================
# AUTH (Release Phase 2 §18.2)
# =============================================================================
# 32-byte hex secret used to sign access JWTs (HS256). MUST be set in CI / staging / prod.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=

# 32-byte hex key used to derive the AES-256-GCM key for BYOK API keys and
# TOTP secrets. MUST be set in CI / staging / prod. Same command as above.
BYOK_ENCRYPTION_KEY=

# OAuth provider credentials (Google + GitHub SSO).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Transactional email (Resend) — used by verification + password reset + admin invites.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@zanganehai.com

# Web push (VAPID) — §19.5 / IMPLEMENTATION_PLAN §6b
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:notifications@zanganehai.com

# SMS (Twilio) — interview reminders only
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Frontend base URL used to build email confirmation links.
FRONTEND_BASE_URL=http://localhost:3000

# =============================================================================
# STRIPE / BILLING (Release Phase 2 §18.3 + IMPLEMENTATION_PLAN §7)
# =============================================================================
# Secret API key (sk_live_... / sk_test_...). REQUIRED in CI / staging / prod.
STRIPE_SECRET_KEY=
# Webhook signing secret used to verify event signatures before any DB write.
STRIPE_WEBHOOK_SECRET=

# Bootstrap / disaster-recovery price IDs.  PlanConfig rows take precedence
# at runtime; these env vars are only used when no active PlanConfig exists
# for a given canonical code.
STRIPE_PRICE_DAILY=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_MONTHLY_YEARLY=

STRIPE_PRICE_BETTER_PACK=
STRIPE_PRICE_BETTER_MONTHLY=
STRIPE_PRICE_BETTER_YEARLY=

STRIPE_PRICE_BEST_PER_RESUME=
STRIPE_PRICE_BEST_MONTHLY=
STRIPE_PRICE_BEST_YEARLY=

# Default currency for /api/billing/prices.
BILLING_CURRENCY=USD

# =============================================================================
# JOB SEARCH (Release Phase 3 §18.10)
# =============================================================================
# Real-time semantic search provider (Hirebase) and background cache (Apify).
HIREBASE_API_KEY=
APIFY_API_TOKEN=
APIFY_ACTOR_ID=automation-lab/google-jobs-scraper
JOB_CACHE_TTL_COMMON_SECONDS=3600
JOB_CACHE_TTL_UNIQUE_SECONDS=86400

# SQS queue URL populated by infra/terraform (Apify cache writer pipeline).
JOB_CACHE_SQS_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_ATTACHMENTS=
