# Smart Resume Agent — Backend Environment Variables
#
# Setup:
#   cp .env.example .env
#   Edit .env with your real API key (do NOT commit .env to git)
#   Restart the backend after any change to this file
#
# The UI also shows these options under "Advanced: LLM Provider" on the JD step.

# =============================================================================
# LLM PROVIDER & MODEL REFERENCE
# =============================================================================
#
# Set LLM_PROVIDER to one row below, then set LLM_MODEL to a model from that row.
# Only the API key for your chosen provider is required.
#
# ┌─────────────┬──────────────────────────────┬─────────────────────────────────────────────────────────────┐
# │ LLM_PROVIDER│ Env var for API key          │ LLM_MODEL options (pick one)                                │
# ├─────────────┼──────────────────────────────┼─────────────────────────────────────────────────────────────┤
# │ openai      │ OPENAI_API_KEY               │ gpt-4o              ← recommended (best balance)            │
# │             │ platform.openai.com/api-keys │ gpt-4o-mini         ← fast & cheap, good for testing      │
# │             │                              │ gpt-4-turbo         ← previous flagship, higher cost      │
# ├─────────────┼──────────────────────────────┼─────────────────────────────────────────────────────────────┤
# │ anthropic   │ ANTHROPIC_API_KEY            │ claude-3-5-sonnet-20241022  ← recommended                 │
# │             │ console.anthropic.com        │ claude-3-opus-20240229      ← highest quality             │
# │             │                              │ claude-3-haiku-20240307     ← fast & cheap                │
# ├─────────────┼──────────────────────────────┼─────────────────────────────────────────────────────────────┤
# │ gemini      │ GOOGLE_API_KEY               │ gemini-2.5-flash        ← recommended (fast & cheap)       │
# │             │ aistudio.google.com/apikey   │ gemini-3.5-flash        ← latest stable flash             │
# │             │                              │ gemini-2.5-flash-lite   ← cheapest                        │
# ├─────────────┼──────────────────────────────┼─────────────────────────────────────────────────────────────┤
# │ openrouter  │ OPENROUTER_API_KEY           │ meta-llama/llama-3.1-70b-instruct                           │
# │             │ openrouter.ai/keys           │ meta-llama/llama-3.1-8b-instruct                            │
# │             │ (300+ models, one key)       │ mistralai/mixtral-8x7b-instruct                             │
# │             │                              │ anthropic/claude-3.5-sonnet                                 │
# │             │                              │ openai/gpt-4o                                               │
# ├─────────────┼──────────────────────────────┼─────────────────────────────────────────────────────────────┤
# │ ollama      │ (none — runs locally)        │ llama3.1:8b         ← recommended (fast, free)            │
# │             │ ollama.com                   │ llama3.1:70b        ← higher quality, needs more RAM       │
# │             │ ollama pull llama3.1:8b      │ mistral:7b          ← lightweight                          │
# │             │                              │ qwen2.5:14b         ← strong coding/reasoning              │
# └─────────────┴──────────────────────────────┴─────────────────────────────────────────────────────────────┘
#
# Notes:
# - Placeholder keys (sk-..., sk-ant-..., sk-or-...) are ignored by the app.
# - Ollama always appears in the UI even without a cloud API key.
# - OpenRouter accepts any model id from https://openrouter.ai/models (not just the list above).

# =============================================================================
# ACTIVE CONFIG — edit these
# =============================================================================

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# --- API keys (only fill in the one matching LLM_PROVIDER above) ---

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=
OPENROUTER_API_KEY=sk-or-...

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# INFRASTRUCTURE
# =============================================================================

REDIS_URL=redis://localhost:6379
# true = no Redis needed for local dev
USE_IN_MEMORY_STORE=true

# Frontend URL for CORS (must match where Next.js runs)
ALLOWED_ORIGINS=["http://localhost:3000"]

# Optional error tracking
SENTRY_DSN=

# =============================================================================
# DATABASE (PostgreSQL + pgvector)
# =============================================================================
# For local dev start postgres with: docker compose up -d postgres
# Then run migrations: cd backend && uv run alembic upgrade head

DATABASE_URL=postgresql+asyncpg://smart_resume:password@localhost:5432/smart_resume

# =============================================================================
# APP ENVIRONMENT
# =============================================================================
# Allowed values: local | development | ci | staging | production
# Controls security decisions (auth enforcement, debug helpers, etc.).
# Never compare APP_ENV directly outside of config.py — use is_production_grade().

APP_ENV=local
